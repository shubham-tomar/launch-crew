# Port the server listens on (default 8080)
PORT=8080
# Postgres connection string (Neon). Locally: make db-up, then
# postgres://postgres:postgres@localhost:5432/launchcrew?sslmode=disable
DATABASE_URL=
# Encryption keyring for stored tokens (id:base64key, comma separated)
KEYRING=
# Public base URL of the app, used for OAuth redirects
BASE_URL=http://localhost:8080
# Buffer OAuth app client id
BUFFER_CLIENT_ID=
# Buffer OAuth app client secret
BUFFER_CLIENT_SECRET=
# GitHub App id
GITHUB_APP_ID=
# GitHub App slug (the name in github.com/apps/<slug>)
GITHUB_APP_SLUG=
# GitHub App private key (PEM)
GITHUB_PRIVATE_KEY=
# GitHub App webhook secret
GITHUB_WEBHOOK_SECRET=
# GitHub App OAuth client id
GITHUB_CLIENT_ID=
# GitHub App OAuth client secret
GITHUB_CLIENT_SECRET=
# Anthropic API key for drafting
ANTHROPIC_API_KEY=
# Cloudflare R2 S3 endpoint
R2_ENDPOINT=
# R2 bucket for launch cards
R2_BUCKET=
# R2 access key id
R2_ACCESS_KEY=
# R2 secret access key
R2_SECRET_KEY=
# Public base URL serving the R2 bucket
R2_PUBLIC_BASE=
# Concurrent job worker goroutines (default 2)
WORKER_CONCURRENCY=2
# Address shown on the settings page when deletion fails (optional)
SUPPORT_EMAIL=
# Resend API key for captain emails (optional; email is hidden in settings without it)
RESEND_API_KEY=
# Sender for captain emails, e.g. "Launch Crew <hello@yourdomain>" (optional)
MAIL_FROM=
